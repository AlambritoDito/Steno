{
  "name": "steno",
  "version": "1.0.0-beta.1",
  "description": "Private desktop transcription for classes and meetings",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test:electron": "node --test electron/*.test.js",
    "build:assets": "uv run --frozen --extra build python scripts/build_assets.py",
    "build:python": "uv run --frozen --extra build python scripts/build_python.py",
    "build:electron": "node scripts/build_electron.js",
    "build": "npm run build:assets && npm run build:python && npm run build:electron",
    "smoke:backend": "uv run --frozen --extra dev python scripts/smoke_backend.py",
    "test:ui": "node --test tests/session-ui.test.cjs"
  },
  "author": "Steno contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlambritoDito/Steno.git"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.steno.app",
    "productName": "Steno",
    "directories": {
      "output": "release",
      "buildResources": "packaging/resources"
    },
    "artifactName": "Steno-${version}-${os}-${arch}.${ext}",
    "forceCodeSigning": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "packaging/resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "27.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Steno uses your microphone to transcribe audio locally."
      }
    },
    "dmg": {
      "sign": false,
      "icon": "packaging/resources/icon.icns",
      "backgroundColor": "#f5f5f7",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 175,
          "y": 170,
          "type": "file"
        },
        {
          "x": 485,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "packaging/resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "packaging/installer.nsh"
    },
    "extraResources": [
      {
        "from": "dist/steno-server",
        "to": "steno-server"
      }
    ],
    "files": [
      "electron/**/*.js",
      "!electron/**/*.test.js"
    ]
  }
}
